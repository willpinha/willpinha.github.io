<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{%- set heading = pageTitle or title %}
		<title>{% if heading %}{{ site.title }} - {{ heading }}{% else %}{{ site.title }}{% endif %}</title>
		<link rel="icon" type="image/png" href="/assets/favicon.png" />
		<link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml" />
		<link rel="stylesheet" href="/assets/prism.css" />
		<style>
			@import url("https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;700&display=swap");

			:root {
				--width: 720px;
				--font-main: "Roboto Mono", monospace;
				--font-scale: 0.9em;
				--background-color: #fff;
				--heading-color: #232333;
				--text-color: #232333;
				--link-color: #232333;
				--main-color: #ff0000;
				--code-background-color: #f2f2f2;
				--code-color: #222;
			}

			body {
				font-family: var(--font-main);
				font-size: var(--font-scale);
				margin: auto;
				padding: 20px;
				max-width: var(--width);
				text-align: left;
				background-color: var(--background-color);
				word-wrap: break-word;
				overflow-wrap: break-word;
				line-height: 1.5;
				color: var(--text-color);
			}

			h1,
			h2,
			h3,
			h4,
			h5,
			h6 {
				color: var(--heading-color);
			}

			a {
				color: var(--link-color);
				cursor: pointer;
				text-decoration: none;
				border-bottom: 3px solid var(--main-color);
			}

			a:hover {
				background-color: var(--main-color);
				color: white;
			}

			header {
				margin-bottom: 40px;
				padding-bottom: 20px;
				border-bottom: 3px dotted var(--heading-color);
			}

			.title h1 {
				font-size: 1.5em;
				margin: 0;
			}

			.header-top {
				display: flex;
				margin: 1em 0;
				flex-wrap: wrap;
				align-items: center;
				gap: 0 1rem;
			}

			.title {
				border-bottom: none;
			}

			.title:hover {
				background-color: transparent;
			}

			.visitors {
				margin-left: auto;
				white-space: nowrap;
			}

			nav a {
				margin-right: 8px;
			}

			strong,
			b {
				color: var(--heading-color);
			}

			main {
				line-height: 1.6;
			}

			img {
				max-width: 100%;
			}

			code {
				font-family: var(--font-main);
				padding: 0 2px;
				background-color: var(--code-background-color);
				color: var(--code-color);
				border-radius: 3px;
			}

			footer {
				margin-top: 40px;
				border-top: 3px dotted var(--heading-color);
				padding: 25px 0;
				text-align: center;
			}

			.avatar-link {
				border-bottom: none;
			}

			.avatar-link:hover {
				background-color: transparent;
			}

			.item-avatar {
				width: 20px;
				height: 20px;
				object-fit: cover;
				border-radius: 50%;
				vertical-align: middle;
				margin-right: 0.25rem;
			}

			.item-number {
				font-size: 0.75em;
				padding: 0.05em 0.3em;
			}

			.contributions-graph {
				overflow-x: auto;
				margin-bottom: 0.75rem;
			}

			.contributions-graph svg {
				display: block;
				margin: 0 auto;
			}

			.contributors {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 0.75rem;
				margin-bottom: 1.5rem;
			}

			.contributor-avatar {
				width: 32px;
				height: 32px;
				object-fit: cover;
				border-radius: 50%;
			}

			.contrib-label {
				font-size: 9px;
				fill: var(--text-color);
				opacity: 0.7;
			}

			.contrib-cell {
				stroke: var(--heading-color);
				stroke-width: 1;
			}

			.contrib-cell:hover {
				stroke: var(--main-color);
				fill: var(--main-color);
			}

			.contrib-level-0 {
				fill: var(--background-color);
			}

			.contrib-level-1 {
				fill: #9be9a8;
			}

			.contrib-level-2 {
				fill: #40c463;
			}

			.contrib-level-3 {
				fill: #30a14e;
			}

			.contrib-level-4 {
				fill: #216e39;
			}

			ul.blog-posts {
				list-style-type: none;
				padding: unset;
			}

			ul.blog-posts li {
				display: flex;
				margin-bottom: 10px;
			}

			ul.blog-posts li span {
				flex: 0 0 130px;
			}

			i time {
				font-style: normal;
				opacity: 0.7;
			}

			ul.photo-items {
				list-style-type: none;
				padding: unset;
				margin-top: 2rem;
			}

			ul.photo-items li {
				display: flex;
				align-items: flex-start;
				gap: 1.5rem;
				margin-bottom: 1.5rem;
			}

			.photo-thumb {
				position: relative;
				z-index: 0;
				display: block;
				flex: 0 0 96px;
				border-bottom: none;
				border-radius: 3px;
				background-color: var(--background-color);
			}

			.photo-thumb:hover {
				background-color: transparent;
			}

			/* The photo is painted over the white square with a soft diagonal sweep once it loads */
			.photo-thumb img {
				display: block;
				width: 96px;
				height: 96px;
				object-fit: cover;
				border-radius: 3px;
				-webkit-mask-image: linear-gradient(115deg, #000 40%, transparent 60%);
				mask-image: linear-gradient(115deg, #000 40%, transparent 60%);
				-webkit-mask-size: 300% 100%;
				mask-size: 300% 100%;
				-webkit-mask-repeat: no-repeat;
				mask-repeat: no-repeat;
				-webkit-mask-position: 100% 0;
				mask-position: 100% 0;
				transition: -webkit-mask-position 0.8s ease-in-out, mask-position 0.8s ease-in-out;
			}

			.photo-thumb img.loaded {
				-webkit-mask-position: 0 0;
				mask-position: 0 0;
			}

			@media (prefers-reduced-motion: reduce) {
				.photo-thumb img {
					transition: none;
				}
			}

			/* Two cards behind the first photo, only for items with several photos */
			.photo-stack::before,
			.photo-stack::after {
				content: "";
				position: absolute;
				inset: 0;
				z-index: -1;
				border: 1px solid var(--heading-color);
				border-radius: 3px;
				background-color: var(--background-color);
			}

			.photo-stack::before {
				transform: translate(6px, 6px);
			}

			.photo-stack::after {
				transform: translate(3px, 3px);
			}

			.photo-count {
				position: absolute;
				top: -6px;
				right: -6px;
				min-width: 1.5em;
				height: 1.5em;
				line-height: 1.5em;
				padding: 0 0.3em;
				box-sizing: border-box;
				border-radius: 999px;
				background-color: var(--main-color);
				color: white;
				font-size: 0.75em;
				text-align: center;
			}

			.photo-text {
				flex: 1;
				min-width: 0;
			}

			.photo-text p {
				margin: 0 0 0.25em;
			}

			.photo-modal {
				width: 100%;
				height: 100%;
				max-width: none;
				max-height: none;
				margin: 0;
				padding: 0;
				border: none;
				background-color: rgba(0, 0, 0, 0.85);
				color: white;
				font-family: var(--font-main);
			}

			.photo-modal::backdrop {
				background: transparent;
			}

			body:has(.photo-modal[open]) {
				overflow: hidden;
			}

			.photo-modal figure {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.75rem;
				width: 100%;
				height: 100%;
				margin: 0;
			}

			.photo-modal img {
				max-width: 90vw;
				max-height: 80vh;
				object-fit: contain;
				border-radius: 3px;
			}

			.photo-modal figcaption {
				max-width: 90vw;
				text-align: center;
			}

			.photo-modal figcaption p {
				margin: 0;
			}

			.photo-modal figcaption a {
				color: white;
			}

			.photo-modal button {
				position: absolute;
				padding: 0.5rem 0.75rem;
				border: none;
				background: none;
				color: white;
				font-family: var(--font-main);
				font-size: 1.5em;
				text-shadow: 0 0 4px black;
				cursor: pointer;
			}

			.photo-modal-close {
				top: 0.5rem;
				right: 0.5rem;
			}

			.photo-modal-prev,
			.photo-modal-next {
				top: 50%;
				transform: translateY(-50%);
			}

			.photo-modal-prev {
				left: 0.5rem;
			}

			.photo-modal-next {
				right: 0.5rem;
			}

			.photo-modal [hidden] {
				display: none;
			}

			/* Fences without a language render as a bare <pre><code>; the Prism selectors are kept to match the theme's specificity */
			code[class*="language-"],
			pre[class*="language-"],
			pre {
				font-family: var(--font-main);
				line-height: 1.5;
			}

			pre[class*="language-"],
			pre {
				padding: 1em;
				margin: 0.5em 0;
				overflow: auto;
				border-radius: 3px;
				background-color: var(--background-color);
				border: 1px solid var(--heading-color);
			}

			pre code {
				padding: 0;
				background: none;
			}
		</style>
	</head>
	<body>
		<header>
			<div class="header-top">
				<a class="title" href="/"><h1>{{ site.title }}</h1></a>
				<small title="Powered by GoatCounter" class="visitors">👁 - unique visitors</small>
			</div>
			<nav>
				<p>
					<a href="/">⌂ Home</a>
					<a href="/blog/">✎ Blog</a>
					<a href="/contributions/">⌗ Contributions</a>
					<a href="/photos/">⧈ Photos</a>
					<a href="https://github.com/{{ site.login }}" target="_blank" rel="noopener noreferrer">GitHub↗</a>
					<a href="https://linkedin.com/in/willpinha" target="_blank" rel="noopener noreferrer">LinkedIn↗</a>
					<a href="/willian-pinheiro-resume.pdf" target="_blank" rel="noopener noreferrer">Resume↗</a>
				</p>
			</nav>
		</header>
		<main>{{ content | safe }}</main>
		<footer>
			<small>⟳ The information on this website is updated daily. Last updated at <b>{{ github.updatedAt }} UTC</b></small>
		</footer>
		<script data-goatcounter="https://willpinha.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
		<script>
			// Hidden on failure because ad blockers often block GoatCounter, which would leave "Loading..." forever
			fetch("https://willpinha.goatcounter.com/counter/TOTAL.json")
				.then((response) => {
					if (!response.ok) throw new Error(`Counter returned ${response.status}`);
					return response.json();
				})
				.then((data) => {
					const count = document.createElement("b");
					count.textContent = data.count;
					document.querySelector(".visitors").replaceChildren("👁 ", count, " unique visitors");
				})
				.catch(() => {
					document.querySelector(".visitors").hidden = true;
				});
		</script>
	</body>
</html>
