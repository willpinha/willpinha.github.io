---
layout: layout.njk
pageTitle: Contributions
---
{% from "item.njk" import item %}
<section>
	<h2>Contributions</h2>
	<p>
		<b>{{ github.contributions.total }}</b> contributions in the last year. They include commits,
		pull requests, issues, and discussions
	</p>
	<div class="contributions-graph">
		<svg
			viewBox="0 0 {{ github.contributions.width }} {{ github.contributions.height }}"
			width="{{ github.contributions.width }}"
			height="{{ github.contributions.height }}"
		>
			{% for label in github.contributions.monthLabels %}
			<text x="{{ label.x }}" y="12" class="contrib-label">{{ label.label }}</text>
			{% endfor %}
			{% for label in github.contributions.weekdayLabels %}
			<text x="0" y="{{ label.y }}" class="contrib-label">{{ label.label }}</text>
			{% endfor %}
			{% for cell in github.contributions.cells %}
			<rect x="{{ cell.x }}" y="{{ cell.y }}" width="9" height="9" rx="2" class="contrib-level-{{ cell.level }}">
				<title>{{ cell.tooltip }}</title>
			</rect>
			{% endfor %}
		</svg>
	</div>
	<p>
		Below are all the users and organizations I've contributed to. They are
		ordered by total contributions; you can hover over each one to see the
		total contributions
	</p>
	<div class="contributors">
		{% for contributor in github.contributions.contributors %}
		<a class="avatar-link" href="https://github.com/{{ contributor.login }}" target="_blank" rel="noopener noreferrer"><img class="contributor-avatar" src="{{ contributor.avatarUrl }}" alt="{{ contributor.login }}" title="{{ contributor.tooltip }}" loading="lazy" /></a>
		{% endfor %}
	</div>
</section>

<section>
	<h2>My most famous repositories</h2>
	<ul>
		{% for repo in github.repos %}
		<li><a href="{{ repo.url }}" target="_blank" rel="noopener noreferrer">{{ repo.name }}</a> ★ {{ repo.stars }}</li>
		{% endfor %}
	</ul>
</section>

<section>
	<h2>Latest pull requests I created [<a href="/pull-requests/">see all</a>]</h2>
	<ul>
		{% for it in github.pullRequests.latest %}
		<li>{{ item(it) }}</li>
		{% endfor %}
	</ul>
</section>

<section>
	<h2>Latest issues I participated in [<a href="/issues/">see all</a>]</h2>
	<ul>
		{% for it in github.issues.latest %}
		<li>{{ item(it) }}</li>
		{% endfor %}
	</ul>
</section>

<section>
	<h2>Latest discussions I participated in [<a href="/discussions/">see all</a>]</h2>
	<ul>
		{% for it in github.discussions.latest %}
		<li>{{ item(it) }}</li>
		{% endfor %}
	</ul>
</section>
